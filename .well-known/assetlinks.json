rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /groups/{gid} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.auth.uid in request.resource.data.admins;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
    match /{col}/{id} {
      allow read, write: if request.auth != null && col in ['reqs','msgs','status','calls','fchunks'];
    }
  }
}
